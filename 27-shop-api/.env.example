# For `cargo test` on the host, use 127.0.0.1 (Compose service name `db` only works inside Docker).
DATABASE_URL=postgres://user:secret@127.0.0.1:5432/mydb
RUST_LOG=info

# Optional: comma-separated exact origins allowed for CORS (e.g. your WASM dev server).
# If unset, the API echoes the request `Origin` header (handy for local dev on any port).
# CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
